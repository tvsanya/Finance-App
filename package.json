{
  "name": "tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",

    "electron:dev": "vite & electron .",
    "electron:build": "npm run build && electron-builder"

  },
  "build": {
    "appId": "com.yourcompany.financeapp",
    "productName": "Finance App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "electron/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "electron/icon.icns",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "electron/icon.png",
      "category": "Office"
    }
  },

  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.9",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pinia": "^4.0.3",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
